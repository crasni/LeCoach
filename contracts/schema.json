    "SpeechMetricsPayload": {
      "additionalProperties": false,
      "properties": {
        "window_start_s": {
          "minimum": 0,
          "title": "Window Start S",
          "type": "number"
        },
        "window_end_s": {
          "minimum": 0,
          "title": "Window End S",
          "type": "number"
        },
        "availability": {
          "enum": [
            "available",
            "unavailable",
            "error"
          ],
          "title": "Availability",
          "type": "string"
        },
        "wpm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Wpm"
        },
        "filler_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Filler Count"
        },
        "filler_rate_per_min": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Filler Rate Per Min"
        },
        "pause": {
          "$ref": "#/$defs/Pause"
        }
      },
      "required": [
        "window_start_s",
        "window_end_s",
        "availability",
        "wpm",
        "filler_count",
        "filler_rate_per_min",
        "pause"
      ],
      "title": "SpeechMetricsPayload",
      "type": "object"
    },
