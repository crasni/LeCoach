     <draw:page-thumbnail draw:name="Slide Image Placeholder 1" draw:style-name="gr8" draw:layer="layout" svg:width="0cm" svg:height="0cm" svg:x="0cm" svg:y="0cm" draw:page-number="6" presentation:class="page"/>
     <draw:frame draw:name="Notes Placeholder 2" presentation:style-name="pr17" draw:text-style-name="P16" draw:layer="layout" svg:width="0cm" svg:height="0cm" svg:x="0cm" svg:y="0cm" presentation:class="notes" presentation:user-transformed="true">
      <draw:text-box>
       <text:p text:style-name="P11"><text:span text:style-name="T5">Computed synthetic coaching using the sole engine, recorder and generator. https://github.com/crasni/LeCoach/blob/ff24d09/checks/coaching/demo/README.md</text:span></text:p>
       <text:p text:style-name="P11"><text:span text:style-name="T5">Reproduce: uv run python checks/coaching/feedback_replay.py --case weak_to_improved --show-feedback</text:span></text:p>
       <text:p text:style-name="P11"><text:span text:style-name="T5">Input: authored speech/vision. Output: generated coaching. Capture anchors 10/25/40 seconds differ from audience decision times 20/30/35/40. At 40 seconds, cited facing evidence is vision-35, not uncited vision-40. These are illustrative fixture values, not live measurements.</text:span></text:p>
      </draw:text-box>
     </draw:frame>
