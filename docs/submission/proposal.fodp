    <presentation:notes draw:style-name="dp4">
     <draw:page-thumbnail draw:name="Slide Image Placeholder 1" draw:style-name="gr8" draw:layer="layout" svg:width="0cm" svg:height="0cm" svg:x="0cm" svg:y="0cm" draw:page-number="10" presentation:class="page"/>
     <draw:frame draw:name="Notes Placeholder 2" presentation:style-name="pr17" draw:text-style-name="P16" draw:layer="layout" svg:width="0cm" svg:height="0cm" svg:x="0cm" svg:y="0cm" presentation:class="notes" presentation:user-transformed="true">
      <draw:text-box>
       <text:p text:style-name="P11"><text:span text:style-name="T5">Owner-published actual vision timing, 2026-10-10, source 81dead7: https://github.com/crasni/LeCoach/issues/16#issuecomment-6096632027</text:span></text:p>
       <text:p text:style-name="P11"><text:span text:style-name="T5">Ubuntu 26.04.1 x86_64, Ryzen AI 7 450, about 30 GiB RAM, Python 3.12.14. Model prepared; public prewarm/join/build adapter, camera 0, unchanged VisionConfig. Three fresh five-second captures, 50 frames each, stop/drain, counters parsed through canonical event validator. All camera releases true, no read/inference errors. These producer/session start/release endpoints are not capture-to-browser, concurrent speech/vision or accelerator timing. No average/distribution benchmark generalized from three samples.</text:span></text:p>
      </draw:text-box>
     </draw:frame>
     <draw:frame draw:name="Slide Number Placeholder 3" presentation:style-name="pr27" draw:text-style-name="P17" draw:layer="layout" svg:width="0cm" svg:height="0cm" svg:x="0cm" svg:y="0cm" presentation:class="page-number" presentation:user-transformed="true">
      <draw:text-box>
       <text:p/>
      </draw:text-box>
     </draw:frame>
    </presentation:notes>
   </draw:page>
