        "phase": {
          "enum": [
            "prepared",
            "running",
            "stopping",
            "completed"
          ],
          "title": "Phase",
          "type": "string"
        },
        "elapsed_s": {
          "minimum": 0,
          "title": "Elapsed S",
          "type": "number"
        },
        "duration_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Duration S"
        },
        "incomplete_sources": {
          "items": {
            "enum": [
              "speech",
              "vision"
            ],
            "type": "string"
          },
          "title": "Incomplete Sources",
          "type": "array"
        },
        "input_status": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Input Status",
          "type": "object"
        },
        "latest_events": {
          "additionalProperties": {
            "discriminator": {
              "mapping": {
                "engagement.state": "#/$defs/EngagementEvent",
                "session.completed": "#/$defs/CompletedEvent",
                "session.started": "#/$defs/StartedEvent",
                "session.stopping": "#/$defs/StoppingEvent",
                "signal.status": "#/$defs/StatusEvent",
                "speech.metrics": "#/$defs/SpeechMetricsEvent",
                "speech.transcript": "#/$defs/TranscriptEvent",
                "vision.metrics": "#/$defs/VisionMetricsEvent"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/StartedEvent"
              },
              {
                "$ref": "#/$defs/StoppingEvent"
              },
              {
                "$ref": "#/$defs/CompletedEvent"
              },
              {
                "$ref": "#/$defs/StatusEvent"
              },
              {
                "$ref": "#/$defs/TranscriptEvent"
              },
              {
                "$ref": "#/$defs/SpeechMetricsEvent"
              },
              {
                "$ref": "#/$defs/VisionMetricsEvent"
              },
              {
                "$ref": "#/$defs/EngagementEvent"
              }
            ]
          },
          "title": "Latest Events",
          "type": "object"
        },
        "transcript": {
          "items": {
            "discriminator": {
              "mapping": {
                "engagement.state": "#/$defs/EngagementEvent",
                "session.completed": "#/$defs/CompletedEvent",
                "session.started": "#/$defs/StartedEvent",
                "session.stopping": "#/$defs/StoppingEvent",
                "signal.status": "#/$defs/StatusEvent",
                "speech.metrics": "#/$defs/SpeechMetricsEvent",
                "speech.transcript": "#/$defs/TranscriptEvent",
                "vision.metrics": "#/$defs/VisionMetricsEvent"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/StartedEvent"
              },
              {
                "$ref": "#/$defs/StoppingEvent"
              },
              {
                "$ref": "#/$defs/CompletedEvent"
              },
              {
                "$ref": "#/$defs/StatusEvent"
              },
              {
                "$ref": "#/$defs/TranscriptEvent"
              },
              {
                "$ref": "#/$defs/SpeechMetricsEvent"
              },
              {
                "$ref": "#/$defs/VisionMetricsEvent"
              },
              {
                "$ref": "#/$defs/EngagementEvent"
              }
            ]
          },
          "title": "Transcript",
          "type": "array"
        },
        "feedback_status": {
          "enum": [
            "pending",
            "ready",
            "unavailable"
          ],
          "title": "Feedback Status",
          "type": "string"
        },
        "output_provenance": {
          "enum": [
            "hand_authored",
            "computed"
          ],
          "title": "Output Provenance",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        }
      },
      "required": [
        "session_id",
        "mode",
        "phase",
        "elapsed_s",
        "duration_s",
        "incomplete_sources",
        "input_status",
        "latest_events",
        "transcript",
        "feedback_status",
        "output_provenance",
        "error"
      ],
      "title": "SessionSnapshot",
      "type": "object"
    },
