    <draw:custom-shape draw:name="Live footage needs its own supported moments and visible mode label.&#10;F" draw:style-name="gr105" draw:text-style-name="P26" draw:layer="layout" svg:width="30.479cm" svg:height="1.983cm" svg:x="1.693cm" svg:y="15.61cm">
     <text:p text:style-name="P11"><text:span text:style-name="T13">Live footage needs its own supported moments and visible mode label.</text:span></text:p>
     <text:p text:style-name="P11"><text:span text:style-name="T13">Final narration/edit timing and recording remain pending.</text:span></text:p>
     <draw:enhanced-geometry draw:mirror-horizontal="false" draw:mirror-vertical="false" draw:glue-points="?f0 0 0 ?f1 ?f0 ?f2 ?f3 ?f1" draw:text-areas="0 0 ?f3 ?f2" svg:viewBox="0 0 0 0" draw:type="ooxml-rect" draw:enhanced-path="M 0 0 L ?f3 0 ?f3 ?f2 0 ?f2 Z N">
