    <draw:custom-shape draw:name="Every selected moment retains its supporting event IDs.&#10;The selector r" draw:style-name="gr54" draw:text-style-name="P26" draw:layer="layout" svg:width="30.479cm" svg:height="1.851cm" svg:x="1.693cm" svg:y="15.531cm">
     <text:p text:style-name="P11"><text:span text:style-name="T13">Every selected moment retains its supporting event IDs.</text:span></text:p>
     <text:p text:style-name="P11"><text:span text:style-name="T13">The selector reports fewer moments when evidence is limited.</text:span></text:p>
     <draw:enhanced-geometry draw:mirror-horizontal="false" draw:mirror-vertical="false" draw:glue-points="?f0 0 0 ?f1 ?f0 ?f2 ?f3 ?f1" draw:text-areas="0 0 ?f3 ?f2" svg:viewBox="0 0 0 0" draw:type="ooxml-rect" draw:enhanced-path="M 0 0 L ?f3 0 ?f3 ?f2 0 ?f2 Z N">
