          <draw:text-box>
            <text:p text:style-name="P1">Before the meeting,</text:p>
            <text:p text:style-name="P1">rehearse in private.</text:p>
          </draw:text-box>
        </draw:frame>
        <draw:frame draw:name="Object28" draw:style-name="G1" svg:x="1.45cm" svg:y="5.6cm" svg:width="30.2cm" svg:height="1.3cm">
          <draw:text-box>
            <text:p text:style-name="P10">Initial user hypothesis: workplace speakers who need a repeatable way to practice delivery.</text:p>
          </draw:text-box>
        </draw:frame>
        <draw:frame draw:name="Object29" draw:style-name="G1" svg:x="1.4cm" svg:y="17.7cm" svg:width="20cm" svg:height="0.5cm">
          <draw:text-box>
            <text:p text:style-name="P2">LeCoach  /  Your Private AI Audience</text:p>
          </draw:text-box>
        </draw:frame>
        <draw:frame draw:name="Object30" draw:style-name="G1" svg:x="26.8cm" svg:y="17.7cm" svg:width="5.6cm" svg:height="0.5cm">
          <draw:text-box>
            <text:p text:style-name="P3">STAGE I  /  02</text:p>
          </draw:text-box>
        </draw:frame>
