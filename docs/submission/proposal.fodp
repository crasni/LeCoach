    </draw:custom-shape>
    <presentation:notes draw:style-name="dp4">
     <draw:page-thumbnail draw:name="Slide Image Placeholder 1" draw:style-name="gr8" draw:layer="layout" svg:width="0cm" svg:height="0cm" svg:x="0cm" svg:y="0cm" draw:page-number="7" presentation:class="page"/>
     <draw:frame draw:name="Notes Placeholder 2" presentation:style-name="pr17" draw:text-style-name="P16" draw:layer="layout" svg:width="0cm" svg:height="0cm" svg:x="0cm" svg:y="0cm" presentation:class="notes" presentation:user-transformed="true">
      <draw:text-box>
       <text:p text:style-name="P11"><text:span text:style-name="T5">Canonical composition: https://github.com/crasni/LeCoach/blob/ff24d09/docs/ARCHITECTURE.md</text:span></text:p>
       <text:p text:style-name="P11"><text:span text:style-name="T5">Executable implementation: https://github.com/crasni/LeCoach/tree/ff24d09/src/lecoach</text:span></text:p>
       <text:p text:style-name="P11"><text:span text:style-name="T5">Python 3.12/FastAPI backend, React/TypeScript frontend. Local CPU adapters. One shared monotonic session clock and canonical event envelope. Engine/recorder consume events independently. Coaching reads the completed recorder, not a second engine. Browser connects via loopback HTTP/WebSocket. Diagram is native editable slide objects.</text:span></text:p>
      </draw:text-box>
     </draw:frame>
     <draw:frame draw:name="Slide Number Placeholder 3" presentation:style-name="pr24" draw:text-style-name="P17" draw:layer="layout" svg:width="0cm" svg:height="0cm" svg:x="0cm" svg:y="0cm" presentation:class="page-number" presentation:user-transformed="true">
