    <draw:custom-shape draw:name="The recorder also retains source observations.&#10;Coaching explains the e" draw:style-name="gr66" draw:text-style-name="P26" draw:layer="layout" svg:width="30.479cm" svg:height="2.169cm" svg:x="1.693cm" svg:y="14.949cm">
     <text:p text:style-name="P11"><text:span text:style-name="T13">The recorder also retains source observations.</text:span></text:p>
     <text:p text:style-name="P11"><text:span text:style-name="T13">Coaching explains the engine’s evidence rather than creating new audience states.</text:span></text:p>
     <draw:enhanced-geometry draw:mirror-horizontal="false" draw:mirror-vertical="false" draw:glue-points="?f0 0 0 ?f1 ?f0 ?f2 ?f3 ?f1" draw:text-areas="0 0 ?f3 ?f2" svg:viewBox="0 0 0 0" draw:type="ooxml-rect" draw:enhanced-path="M 0 0 L ?f3 0 ?f3 ?f2 0 ?f2 Z N">
