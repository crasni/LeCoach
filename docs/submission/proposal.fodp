        <draw:frame draw:name="Object6" draw:style-name="G1" svg:x="1.4cm" svg:y="16.8cm" svg:width="30.5cm" svg:height="0.65cm">
          <draw:text-box>
            <text:p text:style-name="P4">Proposal draft • 8 October 2026 • Synthetic inputs, computed audience, authored coaching</text:p>
          </draw:text-box>
        </draw:frame>
        <draw:frame draw:name="Object7" draw:style-name="G1" svg:x="1.45cm" svg:y="5.5cm" svg:width="20cm" svg:height="3.9cm">
          <draw:text-box>
            <text:p text:style-name="P5">Practice alone.</text:p>
            <text:p text:style-name="P5">Feel an audience.</text:p>
          </draw:text-box>
        </draw:frame>
        <draw:frame draw:name="Object8" draw:style-name="G1" svg:x="1.5cm" svg:y="10.25cm" svg:width="19.7cm" svg:height="2.2cm">
          <draw:text-box>
            <text:p text:style-name="P6">Your Private AI Audience.</text:p>
            <text:p text:style-name="P6">A local rehearsal experience for workplace presenters.</text:p>
          </draw:text-box>
        </draw:frame>
        <draw:ellipse draw:name="Object9" draw:style-name="G0" svg:x="24.1cm" svg:y="6.0cm" svg:width="2.05cm" svg:height="2.05cm" />
        <draw:ellipse draw:name="Object10" draw:style-name="G2" svg:x="24.6cm" svg:y="6.52cm" svg:width="0.16cm" svg:height="0.18cm" />
