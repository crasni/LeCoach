      <draw:page draw:name="02" draw:style-name="PageStyle" draw:master-page-name="Master">
        <draw:rect draw:name="Object25" draw:style-name="G0" svg:x="1.2cm" svg:y="1.08cm" svg:width="0.14cm" svg:height="0.55cm" draw:corner-radius="0.18cm" />
