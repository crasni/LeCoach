        <draw:rect draw:name="Object12" draw:style-name="G2" svg:x="24.67cm" svg:y="7.18cm" svg:width="0.84cm" svg:height="0.075cm" draw:corner-radius="0.18cm" />
        <draw:frame draw:name="Object13" draw:style-name="G1" svg:x="27.0cm" svg:y="6.7cm" svg:width="5.0cm" svg:height="0.6cm">
