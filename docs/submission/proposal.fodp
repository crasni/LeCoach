     <draw:page-thumbnail draw:name="Slide Image Placeholder 1" draw:style-name="gr8" draw:layer="layout" svg:width="0cm" svg:height="0cm" svg:x="0cm" svg:y="0cm" draw:page-number="9" presentation:class="page"/>
     <draw:frame draw:name="Notes Placeholder 2" presentation:style-name="pr17" draw:text-style-name="P16" draw:layer="layout" svg:width="0cm" svg:height="0cm" svg:x="0cm" svg:y="0cm" presentation:class="notes" presentation:user-transformed="true">
      <draw:text-box>
       <text:p text:style-name="P11"><text:span text:style-name="T5">Public sanitized pickup reported by integration, observed 2026-10-10 at source 225550f. https://github.com/crasni/LeCoach/issues/20#issuecomment-6096660374</text:span></text:p>
       <text:p text:style-name="P11"><text:span text:style-name="T5">Ubuntu 26.04.1 x86_64, Ryzen AI 7 450, about 30 GiB RAM. Default configs, local CPU, factory prepare_live_factory + SessionManager, 22.6512-second capture. Default microphone had microphone_no_signal. No scripted speech/posture or browser capture. Moment anchor 4.0 seconds, vision-3/4/5/6 with available person/pose windows ending 4/5/6/7 seconds and facing 0/0.1248/0/0. engagement-1 at 7.024865682 seconds, NEUTRAL to BORED, facing_away_sustained, exactly cites those vision IDs. One supported vision improvement only. No usable speech, partial camera coverage, no strength/recovery claim. Author reviewed the published chain, did not repeat the device run or inspect its ignored private export.</text:span></text:p>
      </draw:text-box>
     </draw:frame>
     <draw:frame draw:name="Slide Number Placeholder 3" presentation:style-name="pr26" draw:text-style-name="P17" draw:layer="layout" svg:width="0cm" svg:height="0cm" svg:x="0cm" svg:y="0cm" presentation:class="page-number" presentation:user-transformed="true">
      <draw:text-box>
       <text:p/>
      </draw:text-box>
     </draw:frame>
    </presentation:notes>
   </draw:page>
